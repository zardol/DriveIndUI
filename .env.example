# Server only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
# Required when the AI server is accessed remotely. Share separately with demo participants.
AI_ACCESS_TOKEN=
# Persist this file across server restarts. Run one API instance against this ledger.
AI_LEDGER_PATH=.local/ai-usage.json
# 150 attempted API calls maximum; cached results do not use another call.
AI_MAX_CALLS=150
AI_ALLOWED_ORIGINS=https://zardol.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001
# Public endpoint URL only, never an API key or access token.
# Set GitHub repository variable VITE_AI_API_URL for the Pages build when the server is deployed.
VITE_AI_API_URL=
